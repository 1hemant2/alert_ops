# Copy this file to .env for local development. Never commit real secret values.
POSTGRES_DB=alert_ops
POSTGRES_USER=alertops
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_HOST_PORT=5432

RABBITMQ_USER=alertops
RABBITMQ_PASSWORD=replace-with-a-local-password
RABBITMQ_HOST_PORT=5672
RABBITMQ_UI_HOST_PORT=15672

REDIS_PASSWORD=replace-with-a-local-password
REDIS_HOST_PORT=6379

APP_HOST_PORT=8096
# Generate this value; do not copy the placeholder into a running environment.
JWT_SECRET_BASE64=replace-with-a-base64-encoded-256-bit-key
